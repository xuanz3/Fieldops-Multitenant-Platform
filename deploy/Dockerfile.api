FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY FieldOps.sln ./
COPY src/backend/FieldOps.Api/FieldOps.Api.csproj src/backend/FieldOps.Api/
COPY src/backend/FieldOps.Application/FieldOps.Application.csproj src/backend/FieldOps.Application/
COPY src/backend/FieldOps.Domain/FieldOps.Domain.csproj src/backend/FieldOps.Domain/
COPY src/backend/FieldOps.Infrastructure/FieldOps.Infrastructure.csproj src/backend/FieldOps.Infrastructure/

RUN dotnet restore src/backend/FieldOps.Api/FieldOps.Api.csproj

COPY src/backend/ src/backend/

RUN dotnet publish \
    src/backend/FieldOps.Api/FieldOps.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish ./
COPY deploy/api-entrypoint.sh /app/api-entrypoint.sh

RUN chmod +x /app/api-entrypoint.sh

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["/app/api-entrypoint.sh"]
